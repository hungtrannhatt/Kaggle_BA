   "source": [
    "best_model_name = cv_results_df.iloc[0][\"model\"]\n",
    "print(\"Best model:\", best_model_name)\n",
    "\n",
    "best_model = clone(models[best_model_name])\n",
    "best_model.fit(X, y)\n",
    "\n",
    "if isinstance(best_model, Pipeline):\n",
    "    estimator = best_model.named_steps[\"model\"]\n",
    "else:\n",
    "    estimator = best_model\n",
    "\n",
    "feature_names = X.columns\n",
    "\n",
    "if hasattr(estimator, \"feature_importances_\"):\n",
    "    importance_df = pd.DataFrame({\n",
    "        \"feature\": feature_names,\n",
    "        \"importance\": estimator.feature_importances_\n",
    "    }).sort_values(\"importance\", ascending=False)\n",
    "    \n",
    "    display(importance_df.head(30))\n",
    "    \n",
    "    plt.figure(figsize=(8, 8))\n",
    "    importance_df.head(25).sort_values(\"importance\").plot(\n",
    "        kind=\"barh\",\n",
    "        x=\"feature\",\n",
    "        y=\"importance\",\n",
    "        legend=False\n",
    "    )\n",
    "    plt.title(f\"Top 25 Feature Importances - {best_model_name}\")\n",
    "    plt.xlabel(\"Importance\")\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(\"/kaggle/working/outputs/fig_06_feature_importance.png\", dpi=200)\n",
    "    plt.show()\n",
    "\n",
    "elif hasattr(estimator, \"coef_\"):\n",
    "    coef_df = pd.DataFrame({\n",
    "        \"feature\": feature_names,\n",
    "        \"coef\": estimator.coef_\n",
    "    })\n",
    "    coef_df[\"abs_coef\"] = coef_df[\"coef\"].abs()\n",
    "    coef_df = coef_df.sort_values(\"abs_coef\", ascending=False)\n",
    "    \n",
    "    display(coef_df.head(30))\n",
    "    \n",
    "    plt.figure(figsize=(8, 8))\n",
    "    coef_df.head(25).sort_values(\"abs_coef\").plot(\n",
    "        kind=\"barh\",\n",
    "        x=\"feature\",\n",
    "        y=\"abs_coef\",\n",
    "        legend=False\n",
    "    )\n",
    "    plt.title(f\"Top 25 Absolute Coefficients - {best_model_name}\")\n",
    "    plt.xlabel(\"Absolute coefficient\")\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(\"/kaggle/working/outputs/fig_06_model_coefficients.png\", dpi=200)\n",
    "    plt.show()\n",
    "\n",
    "else:\n",
    "    print(\"Model này không có feature_importances_ hoặc coef_.\")"
   ]
  }
 ],
