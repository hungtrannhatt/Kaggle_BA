   "source": [
    "kf = KFold(\n",
    "    n_splits=N_FOLDS,\n",
    "    shuffle=True,\n",
    "    random_state=RANDOM_STATE\n",
    ")\n",
    "\n",
    "cv_results = []\n",
    "\n",
    "for name, model in models.items():\n",
    "    print(f\"Cross-validating {name}...\")\n",
    "    \n",
    "    scores = cross_val_score(\n",
    "        clone(model),\n",
    "        X,\n",
    "        y,\n",
    "        scoring=\"neg_mean_squared_error\",\n",
    "        cv=kf,\n",
    "        n_jobs=-1\n",
    "    )\n",
    "    \n",
    "    rmse_scores = np.sqrt(-scores)\n",
    "    \n",
    "    cv_results.append({\n",
    "        \"model\": name,\n",
    "        \"cv_rmse_mean\": rmse_scores.mean(),\n",
    "        \"cv_rmse_std\": rmse_scores.std()\n",
    "    })\n",
    "    \n",
    "    print(f\"{name}: mean={rmse_scores.mean():.5f}, std={rmse_scores.std():.5f}\")\n",
    "    print(\"Fold scores:\", rmse_scores)\n",
    "    print(\"-\" * 50)\n",
    "\n",
    "cv_results_df = pd.DataFrame(cv_results).sort_values(\"cv_rmse_mean\")\n",
    "display(cv_results_df)\n",
    "\n",
    "cv_results_df.to_csv(\"/kaggle/working/cv_results.csv\", index=False)"
   ]
  },
