   "source": [
    "os.makedirs(\"/kaggle/working/outputs\", exist_ok=True)\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.hist(train[\"SalePrice\"], bins=40)\n",
    "plt.title(\"Distribution of SalePrice\")\n",
    "plt.xlabel(\"SalePrice\")\n",
    "plt.ylabel(\"Frequency\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"/kaggle/working/outputs/fig_01_saleprice_distribution.png\", dpi=200)\n",
    "plt.show()\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.hist(np.log1p(train[\"SalePrice\"]), bins=40)\n",
    "plt.title(\"Distribution of log1p(SalePrice)\")\n",
    "plt.xlabel(\"log1p(SalePrice)\")\n",
    "plt.ylabel(\"Frequency\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"/kaggle/working/outputs/fig_02_log_saleprice_distribution.png\", dpi=200)\n",
    "plt.show()\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.scatter(train[\"GrLivArea\"], train[\"SalePrice\"], alpha=0.6)\n",
    "plt.title(\"GrLivArea vs SalePrice\")\n",
    "plt.xlabel(\"GrLivArea\")\n",
    "plt.ylabel(\"SalePrice\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"/kaggle/working/outputs/fig_03_grlivarea_vs_saleprice.png\", dpi=200)\n",
    "plt.show()\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "train.boxplot(column=\"SalePrice\", by=\"OverallQual\")\n",
    "plt.title(\"SalePrice by OverallQual\")\n",
    "plt.suptitle(\"\")\n",
    "plt.xlabel(\"OverallQual\")\n",
    "plt.ylabel(\"SalePrice\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"/kaggle/working/outputs/fig_04_saleprice_by_overallqual.png\", dpi=200)\n",
    "plt.show()\n",
    "\n",
    "corr = train.select_dtypes(include=[np.number]).corr(numeric_only=True)[\"SalePrice\"].drop(\"SalePrice\")\n",
    "corr_top = corr.abs().sort_values(ascending=False).head(20)\n",
    "\n",
    "plt.figure(figsize=(8, 7))\n",
    "corr_top.sort_values().plot(kind=\"barh\")\n",
    "plt.title(\"Top 20 Numeric Features Correlated with SalePrice\")\n",
    "plt.xlabel(\"Absolute correlation\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"/kaggle/working/outputs/fig_05_top_correlations.png\", dpi=200)\n",
    "plt.show()\n",
    "\n",
    "display(\n",
    "    pd.DataFrame({\n",
    "        \"feature\": corr_top.index,\n",
    "        \"abs_corr_with_SalePrice\": corr_top.values\n",
    "    })\n",
    ")"
   ]
