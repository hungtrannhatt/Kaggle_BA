   "source": [
    "models = {}\n",
    "\n",
    "models[\"Ridge\"] = Pipeline([\n",
    "    (\"scaler\", RobustScaler()),\n",
    "    (\"model\", Ridge(alpha=10.0, random_state=RANDOM_STATE))\n",
    "])\n",
    "\n",
    "models[\"ElasticNet\"] = Pipeline([\n",
    "    (\"scaler\", RobustScaler()),\n",
    "    (\"model\", ElasticNet(\n",
    "        alpha=0.0007,\n",
    "        l1_ratio=0.9,\n",
    "        max_iter=30000,\n",
    "        random_state=RANDOM_STATE\n",
    "    ))\n",
    "])\n",
    "\n",
    "models[\"RandomForest\"] = RandomForestRegressor(\n",
    "    n_estimators=400,\n",
    "    max_features=\"sqrt\",\n",
    "    random_state=RANDOM_STATE,\n",
    "    n_jobs=-1\n",
    ")\n",
    "\n",
    "models[\"ExtraTrees\"] = ExtraTreesRegressor(\n",
    "    n_estimators=400,\n",
    "    max_features=\"sqrt\",\n",
    "    random_state=RANDOM_STATE,\n",
    "    n_jobs=-1\n",
    ")\n",
    "\n",
    "models[\"GradientBoosting\"] = GradientBoostingRegressor(\n",
    "    n_estimators=1000,\n",
    "    learning_rate=0.03,\n",
    "    max_depth=3,\n",
    "    min_samples_leaf=3,\n",
    "    min_samples_split=8,\n",
    "    subsample=0.8,\n",
    "    max_features=\"sqrt\",\n",
    "    loss=\"huber\",\n",
    "    random_state=RANDOM_STATE\n",
    ")\n",
    "\n",
    "models[\"HistGradientBoosting\"] = HistGradientBoostingRegressor(\n",
    "    max_iter=700,\n",
    "    learning_rate=0.03,\n",
    "    max_leaf_nodes=31,\n",
    "    l2_regularization=0.01,\n",
    "    random_state=RANDOM_STATE\n",
    ")\n",
    "\n",
    "if XGB_AVAILABLE:\n",
    "    models[\"XGBoost\"] = XGBRegressor(\n",
    "        n_estimators=1000,\n",
    "        learning_rate=0.03,\n",
    "        max_depth=3,\n",
    "        min_child_weight=2,\n",
    "        subsample=0.8,\n",
    "        colsample_bytree=0.8,\n",
    "        reg_alpha=0.0005,\n",
    "        reg_lambda=1.0,\n",
    "        objective=\"reg:squarederror\",\n",
    "        random_state=RANDOM_STATE,\n",
    "        n_jobs=2\n",
    "    )\n",
    "\n",
    "print(\"Models:\")\n",
    "print(list(models.keys()))"
   ]
  },
