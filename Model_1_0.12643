    "holdout_results = []\n",
    "\n",
    "for name, model in models.items():\n",
    "    print(f\"Training {name}...\")\n",
    "    \n",
    "    model_clone = clone(model)\n",
    "    model_clone.fit(X_train, y_train)\n",
    "    \n",
    "    valid_pred = model_clone.predict(X_valid)\n",
    "    valid_rmse = rmse_log(y_valid, valid_pred)\n",
    "    \n",
    "    holdout_results.append({\n",
    "        \"model\": name,\n",
    "        \"validation_rmse_log\": valid_rmse\n",
    "    })\n",
    "    \n",
    "    print(f\"{name} validation RMSE:\", valid_rmse)\n",
    "    print(\"-\" * 50)\n",
    "\n",
    "holdout_results_df = pd.DataFrame(holdout_results).sort_values(\"validation_rmse_log\")\n",
    "display(holdout_results_df)\n",
    "\n",
    "holdout_results_df.to_csv(\"/kaggle/working/holdout_results.csv\", index=False)"
   ]
  },
