   "source": [
    "top_k = 3\n",
    "top_models_df = cv_results_df.head(top_k).copy()\n",
    "\n",
    "print(\"Top models selected for ensemble:\")\n",
    "display(top_models_df)\n",
    "\n",
    "top_model_names = top_models_df[\"model\"].tolist()\n",
    "top_model_scores = top_models_df[\"cv_rmse_mean\"].values\n",
    "\n",
    "inverse_scores = 1 / top_model_scores\n",
    "weights = inverse_scores / inverse_scores.sum()\n",
    "\n",
    "print(\"Ensemble weights:\")\n",
    "for name, w in zip(top_model_names, weights):\n",
    "    print(f\"{name}: {w:.4f}\")\n",
    "\n",
    "test_pred_logs = {}\n",
    "\n",
    "for name in top_model_names:\n",
    "    print(f\"Training final model: {name}\")\n",
    "    \n",
    "    model_final = clone(models[name])\n",
    "    model_final.fit(X, y)\n",
    "    \n",
    "    pred_log = model_final.predict(X_test_final)\n",
    "    test_pred_logs[name] = pred_log\n",
    "\n",
    "ensemble_pred_log = np.zeros(len(X_test_final))\n",
    "\n",
    "for name, w in zip(top_model_names, weights):\n",
    "    ensemble_pred_log += w * test_pred_logs[name]\n",
    "\n",
    "ensemble_pred_price = np.expm1(ensemble_pred_log)\n",
    "ensemble_pred_price = np.maximum(ensemble_pred_price, 0)\n",
    "\n",
    "submission = pd.DataFrame({\n",
    "    \"Id\": test_ids,\n",
    "    \"SalePrice\": ensemble_pred_price\n",
    "})\n",
    "\n",
    "display(submission.head())\n",
    "print(\"Submission shape:\", submission.shape)\n",
    "\n",
    "submission_path = \"/kaggle/working/submission.csv\"\n",
    "submission.to_csv(submission_path, index=False)\n",
    "\n",
    "print(\"Saved submission to:\", submission_path)"
   ]
  },
