   "source": [
    "target_col = \"SalePrice\"\n",
    "\n",
    "print(\"Có SalePrice trong train không?\", target_col in train.columns)\n",
    "print(\"Có SalePrice trong test không?\", target_col in test.columns)\n",
    "\n",
    "feature_cols = [c for c in train.columns if c not in [\"Id\", target_col]]\n",
    "num_cols = train[feature_cols].select_dtypes(include=[np.number]).columns.tolist()\n",
    "cat_cols = train[feature_cols].select_dtypes(exclude=[np.number]).columns.tolist()\n",
    "\n",
    "print(\"Số dòng train:\", train.shape[0])\n",
    "print(\"Số dòng test:\", test.shape[0])\n",
    "print(\"Số biến đầu vào:\", len(feature_cols))\n",
    "print(\"Số biến số:\", len(num_cols))\n",
    "print(\"Số biến phân loại:\", len(cat_cols))\n",
    "\n",
    "print(\"\\nThống kê SalePrice:\")\n",
    "display(train[\"SalePrice\"].describe())\n",
    "\n",
    "missing_train = train.isnull().sum().sort_values(ascending=False)\n",
    "missing_train = missing_train[missing_train > 0].reset_index()\n",
    "missing_train.columns = [\"column\", \"missing_count\"]\n",
    "missing_train[\"missing_percent\"] = missing_train[\"missing_count\"] / len(train) * 100\n",
    "\n",
    "print(\"\\nCác cột thiếu dữ liệu nhiều nhất:\")\n",
    "display(missing_train.head(30))"
   ]
  },
